# Get these from your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Get this from resend.com after verifying a sending domain (or use their test domain to start)
RESEND_API_KEY=your-resend-api-key-here

# Email address that receives new appointment notifications
CLINIC_NOTIFY_EMAIL=your-sister-email@example.com
